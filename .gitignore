# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.spec

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Database files (preserve .gitkeep)
data/*.db
data/*.sqlite3
data/*.db-journal
data/*.db-wal
data/*.db-shm
!data/.gitkeep

# Activity logs (preserve .gitkeep)
logs/*.log
logs/*.log.*
!logs/.gitkeep

# Backup archives (preserve .gitkeep)
backups/*.db
backups/*.bak
!backups/.gitkeep

# Generated user reports (preserve .gitkeep)
reports/*.pdf
reports/*.xlsx
reports/*.csv
reports/*.png
!reports/.gitkeep

# IDE configuration
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
